# ── Database ───────────────────────────────────────────────
# 로컬 개발: Docker Compose PostgreSQL
DATABASE_URL="postgresql://alm:alm_dev_password@localhost:5432/alm?schema=public"

# ── App ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-in-production
INTERNAL_EMAIL_DOMAIN=tovis.com

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Meilisearch ────────────────────────────────────────────
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=dev-master-key

# ── MinIO / S3 ─────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_BUCKET=alm-attachments

# ── Keycloak ───────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=alm
KEYCLOAK_CLIENT_ID=alm-backend

# ── MCP ────────────────────────────────────────────────────
# 설정 시 X-MCP-API-Key 헤더 필수
# MCP_API_KEY=change-me
