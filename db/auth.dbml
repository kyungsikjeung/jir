// ============================================================
// DBML: 사용자 인증 & 권한 관리
// Jira/Confluence 느낌 ASPICE ALM
// ============================================================

Project alm_auth {
  database_type: 'PostgreSQL'
  Note: '사용자 인증(회사 이메일) + 관리자 권한 부여 + 권한별 접근 제어'
}

// ── 조직 (회사) ─────────────────────────────────────────────
Table organizations {
  id uuid [pk, default: `uuid_generate_v4()`]
  name varchar(255) [not null]
  slug varchar(100) [unique, not null]
  domain varchar(255) [not null, note: '회사 이메일 도메인 (예: tovis.com)']
  logo_url text
  plan varchar(50) [default: 'free']
  is_active boolean [default: true]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  Note: '회사/조직 단위. 이메일 도메인으로 소속 검증'
}

// ── 사용자 ──────────────────────────────────────────────────
Table users {
  id uuid [pk, default: `uuid_generate_v4()`]
  org_id uuid [ref: > organizations.id, not null]
  email varchar(255) [unique, not null, note: '회사 이메일 (도메인 검증 필수)']
  password_hash varchar(255) [note: 'SSO 사용 시 NULL']
  display_name varchar(255) [not null]
  avatar_url text
  title varchar(100) [note: '직책']
  department varchar(100) [note: '부서']
  is_active boolean [default: true, note: '관리자가 비활성화 가능']
  is_verified boolean [default: false, note: '이메일 인증 여부']
  last_login_at timestamptz
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  Note: '회사 이메일로만 가입 가능. 관리자가 조회/관리'
}

// ── SSO / 외부 인증 ─────────────────────────────────────────
Table user_identities {
  id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [ref: > users.id, not null]
  provider varchar(50) [not null, note: 'google, microsoft, saml, ldap, oidc']
  provider_uid varchar(255) [not null]
  metadata jsonb [default: '{}']
  created_at timestamptz [default: `now()`]

  Indexes {
    (provider, provider_uid) [unique]
  }
}

// ── 역할 (Role) ─────────────────────────────────────────────
Table roles {
  id uuid [pk, default: `uuid_generate_v4()`]
  org_id uuid [ref: > organizations.id]
  name varchar(100) [not null, note: 'Admin, PM, SE, QA, CM, Viewer']
  description text
  is_system boolean [default: false, note: '시스템 기본 역할 (삭제 불가)']
  is_admin boolean [default: false, note: '관리자 역할 여부']
  created_at timestamptz [default: `now()`]

  Indexes {
    (org_id, name) [unique]
  }

  Note: '관리자(Admin)는 사용자 조회/권한 부여 가능'
}

// ── 권한 (Permission) ───────────────────────────────────────
// 허용 목록 (Allowed Actions)
Table permissions {
  id uuid [pk, default: `uuid_generate_v4()`]
  code varchar(100) [unique, not null, note: '예: user.view, user.manage, space.create']
  name varchar(255) [not null, note: '권한 표시명']
  description text
  category varchar(50) [not null, note: 'core, user, space, workitem, requirement, test, config, process']
  action varchar(20) [not null, note: 'create, read, update, delete, approve, manage']
  resource varchar(50) [not null, note: 'user, space, workitem, requirement, test, ...']
  is_system boolean [default: false]

  Note: 'CRUD 등 허용 목록. 역할에 매핑하여 접근 제어'
}

// ── 역할-권한 매핑 ──────────────────────────────────────────
Table role_permissions {
  role_id uuid [ref: > roles.id, not null]
  permission_id uuid [ref: > permissions.id, not null]
  granted_at timestamptz [default: `now()`]

  Indexes {
    (role_id, permission_id) [pk]
  }
}

// ── 사용자-역할 매핑 ────────────────────────────────────────
Table user_roles {
  user_id uuid [ref: > users.id, not null]
  role_id uuid [ref: > roles.id, not null]
  space_id uuid [ref: > spaces.id, note: '스페이스별 역할 (NULL=글로벌)']
  granted_by uuid [ref: > users.id, note: '권한을 부여한 관리자']
  granted_at timestamptz [default: `now()`]
  expires_at timestamptz [note: '임시 권한 만료일']

  Indexes {
    (user_id, role_id, space_id) [pk]
  }

  Note: '관리자가 사용자에게 역할(권한 묶음)을 부여'
}

// ── 스페이스 (Project/Space) ────────────────────────────────
Table spaces {
  id uuid [pk, default: `uuid_generate_v4()`]
  org_id uuid [ref: > organizations.id, not null]
  key varchar(20) [unique, not null]
  name varchar(255) [not null]
  description text
  is_archived boolean [default: false]
  created_by uuid [ref: > users.id]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

// ── 스페이스 멤버 (스페이스별 역할) ─────────────────────────
Table space_members {
  space_id uuid [ref: > spaces.id, not null]
  user_id uuid [ref: > users.id, not null]
  role_id uuid [ref: > roles.id, not null]
  added_by uuid [ref: > users.id, note: '추가한 관리자']
  added_at timestamptz [default: `now()`]

  Indexes {
    (space_id, user_id) [pk]
  }
}

// ── 권한 부여 이력 (Audit) ──────────────────────────────────
Table permission_audit_log {
  id uuid [pk, default: `uuid_generate_v4()`]
  action varchar(30) [not null, note: 'grant, revoke, modify']
  target_user_id uuid [ref: > users.id, not null, note: '권한 대상 사용자']
  performed_by uuid [ref: > users.id, not null, note: '수행한 관리자']
  role_id uuid [ref: > roles.id]
  space_id uuid [ref: > spaces.id, note: '스페이스 범위 (NULL=글로벌)']
  old_permissions jsonb [note: '변경 전 권한 목록']
  new_permissions jsonb [note: '변경 후 권한 목록']
  reason text [note: '변경 사유']
  ip_address inet
  created_at timestamptz [default: `now()`]

  Note: '관리자의 권한 부여/변경/회수 이력 (증적)'
}

// ── 세션/토큰 (로그인 세션) ─────────────────────────────────
Table user_sessions {
  id uuid [pk, default: `uuid_generate_v4()`]
  user_id uuid [ref: > users.id, not null]
  token_hash varchar(255) [unique, not null]
  ip_address inet
  user_agent text
  expires_at timestamptz [not null]
  created_at timestamptz [default: `now()`]
  revoked_at timestamptz [note: '로그아웃/강제 종료 시']

  Note: '로그인 세션 관리'
}

// ── 권한 시드 데이터 (예시) ─────────────────────────────────
// permissions 테이블에 삽입할 기본 권한 목록
// 
// Core:
//   user.view          - 사용자 조회
//   user.manage        - 사용자 관리 (생성/수정/삭제/비활성화)
//   user.role.grant    - 역할/권한 부여
//   user.role.revoke   - 역할/권한 회수
//
// Space:
//   space.view         - 스페이스 조회
//   space.create       - 스페이스 생성
//   space.manage       - 스페이스 설정 관리
//   space.delete       - 스페이스 삭제
//
// Work Item (CRUD):
//   workitem.view      - 조회
//   workitem.create    - 생성
//   workitem.edit      - 수정
//   workitem.delete    - 삭제
//   workitem.assign    - 담당자 할당
//
// Requirement:
//   requirement.view       - 조회
//   requirement.create     - 생성
//   requirement.edit       - 수정
//   requirement.delete     - 삭제
//   requirement.approve    - 승인
//   requirement.release    - 릴리스
//
// Test:
//   test.view          - 조회
//   test.create        - 생성
//   test.edit          - 수정
//   test.delete        - 삭제
//   test.execute       - 실행
//   test.approve       - 결과 승인
//
// Config:
//   baseline.view      - 조회
//   baseline.create    - 생성
//   baseline.approve   - 승인
//   changerequest.view  - 조회
//   changerequest.create - 생성
//   changerequest.approve - 승인
//
// Process:
//   review.conduct     - 리뷰 수행
//   audit.view         - 감사 로그 조회
//   compliance.view    - 컴플라이언스 대시보드 조회
//   process.assess     - 프로세스 평가

// ── 역할별 기본 권한 매핑 (예시) ────────────────────────────
// Admin: 모든 권한
// PM:    space.*, workitem.*, requirement.*, test.*, baseline.view, changerequest.*, review.conduct, audit.view
// SE:    workitem.view/create/edit, requirement.view/create/edit, test.view/create/edit/execute, baseline.view
// QA:    test.*, workitem.view, requirement.view, baseline.view
// CM:    baseline.*, changerequest.*, config.*, audit.view
// Viewer: *.view (읽기 전용)
