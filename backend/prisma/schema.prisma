generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════
// Core (사용자, 조직, 역할, 권한)
// ═══════════════════════════════════════════

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  domain    String
  logoUrl   String?
  plan      String   @default("free")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("organizations")
}

model User {
  id            String   @id @default(uuid())
  orgId         String
  email         String   @unique
  passwordHash  String?
  displayName   String
  avatarUrl     String?
  title         String?
  department    String?
  isInternal    Boolean  @default(false)
  isVerified    Boolean  @default(false)
  isApproved    Boolean  @default(false)
  isActive      Boolean  @default(true)
  isExternal    Boolean  @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([orgId])
  @@index([email])
  @@map("users")
}

model UserIdentity {
  id          String   @id @default(uuid())
  userId      String
  provider    String
  providerUid String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  @@unique([provider, providerUid])
  @@map("user_identities")
}

model Role {
  id          String   @id @default(uuid())
  orgId       String?
  name        String
  description String?
  isSystem    Boolean  @default(false)
  isSuperAdmin Boolean @default(false)
  isAdmin     Boolean  @default(false)
  createdAt   DateTime @default(now())
  @@unique([orgId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  category    String
  action      String
  resource    String
  isSystem    Boolean  @default(false)
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime   @default(now())
  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  spaceId    String?
  grantedBy  String?
  grantedAt  DateTime @default(now())
  expiresAt  DateTime?
  @@map("user_roles")
}

// ═══════════════════════════════════════════
// Spaces
// ═══════════════════════════════════════════

model Space {
  id               String   @id @default(uuid())
  orgId            String
  key              String   @unique
  name             String
  description      String?
  spaceType        String   @default("software")
  iconUrl          String?
  aspiceLevel      String   @default("2")
  automotiveDomain String?
  processProfile   String   @default("default")
  isArchived       Boolean  @default(false)
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([orgId])
  @@index([key])
  @@map("spaces")
}

model SpaceMember {
  spaceId   String
  userId    String
  roleId    String
  addedById String?
  addedAt   DateTime @default(now())
  @@id([spaceId, userId])
  @@map("space_members")
}

model SpaceSettings {
  spaceId                   String  @id
  defaultPageTemplateId     String?
  allowAnonymousView        Boolean @default(false)
  requireApprovalForRelease Boolean @default(true)
  minApprovers              Int     @default(1)
  autoSuspectLinks          Boolean @default(true)
  requireTraceForRelease    Boolean @default(true)
  notificationChannels      Json    @default("[\"in_app\", \"email\"]")
  aspiceLevel               String  @default("2")
  requireEvidenceForAll     Boolean @default(false)
  updatedAt                 DateTime @updatedAt
  @@map("space_settings")
}

model Component {
  id          String   @id @default(uuid())
  spaceId     String
  name        String
  description String?
  leadUserId  String?
  createdAt   DateTime @default(now())
  @@unique([spaceId, name])
  @@map("components")
}

model Label {
  id      String   @id @default(uuid())
  spaceId String
  name    String
  color   String   @default("#6B7280")
  @@unique([spaceId, name])
  @@map("labels")
}

model Version {
  id          String   @id @default(uuid())
  spaceId     String
  name        String
  description String?
  releaseDate DateTime?
  status      String   @default("unreleased")
  createdAt   DateTime @default(now())
  @@unique([spaceId, name])
  @@map("versions")
}

// ═══════════════════════════════════════════
// Work Items
// ═══════════════════════════════════════════

model WorkItemType {
  id             String   @id @default(uuid())
  spaceId        String
  name           String
  icon           String?
  color          String?
  hierarchyLevel Int      @default(0)
  isSubtask      Boolean  @default(false)
  aspiceProcess  String?
  createdAt      DateTime @default(now())
  @@unique([spaceId, name])
  @@map("work_item_types")
}

model WorkItem {
  id              String   @id @default(uuid())
  spaceId         String
  typeId          String
  key             String
  title           String
  description     String?
  status          String   @default("open")
  priority        String   @default("medium")
  assigneeId      String?
  reporterId      String?
  parentId        String?
  epicId          String?
  workflowStateId String?
  version         Int      @default(1)
  body            Json?
  bodyText        String?
  customFields    Json     @default("{}")
  labels          String[]
  aspiceProcess   String?
  asilLevel       String?
  estimatedHours  Decimal? @db.Decimal(10,2)
  actualHours     Decimal? @db.Decimal(10,2)
  progressPercent Int      @default(0)
  dueDate         DateTime?
  storyPoints     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  resolvedAt      DateTime?
  @@unique([spaceId, key])
  @@index([spaceId])
  @@index([status])
  @@index([assigneeId])
  @@index([aspiceProcess])
  @@map("work_items")
}

model WorkItemLink {
  id          String   @id @default(uuid())
  fromId      String
  toId        String
  linkType    String
  createdById String?
  createdAt   DateTime @default(now())
  @@unique([fromId, toId, linkType])
  @@index([fromId])
  @@index([toId])
  @@map("work_item_links")
}

model WorkItemVersion {
  id            String   @id @default(uuid())
  workItemId    String
  version       Int
  title         String?
  body          Json?
  bodyText      String?
  changedById   String?
  changeSummary String?
  createdAt     DateTime @default(now())
  @@unique([workItemId, version])
  @@index([workItemId])
  @@map("work_item_versions")
}

model WorkItemWatcher {
  workItemId String
  userId     String
  addedAt    DateTime @default(now())
  @@id([workItemId, userId])
  @@map("work_item_watchers")
}

// ═══════════════════════════════════════════
// Documents (Confluence 스타일)
// ═══════════════════════════════════════════

model Page {
  workItemId    String   @id
  parentPageId  String?
  templateId    String?
  position      Int      @default(0)
  isHomepage    Boolean  @default(false)
  viewCount     Int      @default(0)
  lastViewedAt  DateTime?
  @@map("pages")
}

model PageTemplate {
  id             String   @id @default(uuid())
  spaceId        String?
  name           String
  description    String?
  body           Json?
  category       String?
  aspiceProcess  String?
  isSystem       Boolean  @default(false)
  createdById    String?
  createdAt      DateTime @default(now())
  @@map("page_templates")
}

model Comment {
  id            String   @id @default(uuid())
  targetType    String
  targetId      String
  parentId      String?
  authorId      String
  body          String
  bodyHtml      String?
  anchor        Json?
  isInline      Boolean  @default(false)
  isResolved    Boolean  @default(false)
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([targetType, targetId])
  @@index([parentId])
  @@map("comments")
}

model CommentReaction {
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  @@id([commentId, userId, emoji])
  @@map("comment_reactions")
}

model Attachment {
  id            String   @id @default(uuid())
  targetType    String
  targetId      String
  fileName      String
  filePath      String
  fileSize      BigInt?
  mimeType      String?
  thumbnailPath String?
  uploadedById  String
  uploadedAt    DateTime @default(now())
  isDeleted     Boolean  @default(false)
  @@index([targetType, targetId])
  @@map("attachments")
}

// ═══════════════════════════════════════════
// Requirements
// ═══════════════════════════════════════════

model Requirement {
  workItemId         String   @id
  reqType            String
  asilLevel          String?
  safetyRelated      Boolean  @default(false)
  rationale          String?
  acceptanceCriteria String?
  verificationMethod String?
  derivedFromId      String?
  reviewStatus       String   @default("draft")
  approvedById       String?
  approvedAt         DateTime?
  baselineId         String?
  externalId         String?
  externalSource     String?
  @@map("requirements")
}

model RequirementAttribute {
  requirementId String
  attrKey       String
  attrValue     String?
  @@id([requirementId, attrKey])
  @@map("requirement_attributes")
}

model RequirementRelation {
  id           String   @id @default(uuid())
  fromReqId    String
  toReqId      String
  relationType String
  createdById  String?
  createdAt    DateTime @default(now())
  @@unique([fromReqId, toReqId, relationType])
  @@map("requirement_relations")
}

// ═══════════════════════════════════════════
// Tests
// ═══════════════════════════════════════════

model TestCase {
  workItemId          String   @id
  testType            String
  preconditions       String?
  postconditions      String?
  steps               Json     @default("[]")
  isAutomated         Boolean  @default(false)
  automationFramework String?
  testEnvironment     String?
  estimatedDuration   Int?
  createdAt           DateTime @default(now())
  @@map("test_cases")
}

model TestSuite {
  id          String   @id @default(uuid())
  spaceId     String
  name        String
  description String?
  parentId    String?
  createdById String?
  createdAt   DateTime @default(now())
  @@map("test_suites")
}

model TestSuiteCase {
  suiteId    String
  testCaseId String
  position   Int      @default(0)
  @@id([suiteId, testCaseId])
  @@map("test_suite_cases")
}

model TestRun {
  id           String   @id @default(uuid())
  spaceId      String
  name         String
  description  String?
  testSuiteId  String?
  environment  String?
  buildVersion String?
  baselineId   String?
  status       String   @default("planned")
  assignedToId String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdById  String?
  createdAt    DateTime @default(now())
  @@index([spaceId])
  @@index([status])
  @@map("test_runs")
}

model TestResult {
  id               String   @id @default(uuid())
  testRunId        String
  testCaseId       String
  result           String
  actualResult     String?
  evidence         Json     @default("[]")
  executedById     String?
  executedAt       DateTime @default(now())
  durationMs       Int?
  defectId         String?
  retryCount       Int      @default(0)
  @@unique([testRunId, testCaseId])
  @@index([testRunId])
  @@index([testCaseId])
  @@map("test_results")
}

model TestCoverage {
  testCaseId     String
  requirementId  String
  coverageType   String   @default("verifies")
  createdAt      DateTime @default(now())
  @@id([testCaseId, requirementId])
  @@map("test_coverage")
}

model Defect {
  workItemId         String   @id
  severity           String
  defectType         String?
  foundInVersion     String?
  foundInEnvironment String?
  fixedInVersion     String?
  rootCause          String?
  reproductionSteps  String?
  timeToFixHours     Decimal? @db.Decimal(10,2)
  safetyImpact       Boolean  @default(false)
  asilLevel          String?
  @@map("defects")
}

// ═══════════════════════════════════════════
// Traceability
// ═══════════════════════════════════════════

model TraceLink {
  id          String   @id @default(uuid())
  fromType    String
  fromId      String
  toType      String
  toId        String
  linkType    String
  description String?
  createdById String?
  createdAt   DateTime @default(now())
  baselineId  String?
  isSuspect   Boolean  @default(false)
  @@unique([fromType, fromId, toType, toId, linkType])
  @@index([fromType, fromId])
  @@index([toType, toId])
  @@index([isSuspect])
  @@map("trace_links")
}

model SuspectLink {
  id           String   @id @default(uuid())
  traceLinkId  String
  reason       String?
  markedAt     DateTime @default(now())
  markedById   String?
  resolvedAt   DateTime?
  resolvedById String?
  resolution   String?
  @@map("suspect_links")
}

model TraceMatrixSnapshot {
  id                  String   @id @default(uuid())
  spaceId             String
  baselineId          String?
  name                String
  matrixData          Json
  totalRequirements   Int      @default(0)
  coveredRequirements Int      @default(0)
  coveragePercent     Decimal  @default(0) @db.Decimal(5,2)
  generatedById       String?
  generatedAt         DateTime @default(now())
  @@map("trace_matrix_snapshots")
}

model CoverageReport {
  id              String   @id @default(uuid())
  spaceId         String
  baselineId      String?
  reportType      String
  totalItems      Int
  coveredItems    Int
  coveragePercent Decimal  @db.Decimal(5,2)
  uncoveredItems  Json     @default("[]")
  generatedById   String?
  generatedAt     DateTime @default(now())
  @@map("coverage_reports")
}

// ═══════════════════════════════════════════
// Config (베이스라인, 변경관리)
// ═══════════════════════════════════════════

model Baseline {
  id            String   @id @default(uuid())
  spaceId       String
  name          String
  description   String?
  version       String?
  baselineType  String   @default("release")
  status        String   @default("draft")
  snapshotData  Json?
  approvedById  String?
  approvedAt    DateTime?
  releasedAt    DateTime?
  createdById   String?
  createdAt     DateTime @default(now())
  @@unique([spaceId, name])
  @@index([spaceId])
  @@index([status])
  @@map("baselines")
}

model BaselineItem {
  baselineId   String
  itemType     String
  itemId       String
  itemVersion  Int?
  @@id([baselineId, itemType, itemId])
  @@map("baseline_items")
}

model ConfigurationItem {
  id             String   @id @default(uuid())
  spaceId        String
  ciType         String
  name           String
  description    String?
  location       String?
  currentVersion String?
  status         String   @default("active")
  linkedWorkItems String[]
  ownerId        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@map("configuration_items")
}

model ChangeRequest {
  workItemId     String   @id
  crType         String   @default("standard")
  impactAnalysis String?
  affectedItems  String[]
  estimatedEffort Int?
  urgency        String   @default("medium")
  approvalStatus String   @default("pending")
  createdAt      DateTime @default(now())
  @@map("change_requests")
}

model ChangeBaselineImpact {
  changeRequestId String
  baselineId      String
  impactLevel     String   @default("medium")
  @@id([changeRequestId, baselineId])
  @@map("change_baseline_impact")
}

model Release {
  id          String   @id @default(uuid())
  spaceId     String
  name        String
  description String?
  version     String?
  releaseDate DateTime?
  status      String   @default("planned")
  baselineId  String?
  createdById String?
  createdAt   DateTime @default(now())
  @@unique([spaceId, name])
  @@map("releases")
}

// ═══════════════════════════════════════════
// Workflow (워크플로우, 리뷰, 승인)
// ═══════════════════════════════════════════

model Workflow {
  id            String   @id @default(uuid())
  spaceId       String?
  name          String
  description   String?
  aspiceProcess String?
  isDefault     Boolean  @default(false)
  isSystem      Boolean  @default(false)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@map("workflows")
}

model WorkflowState {
  id          String   @id @default(uuid())
  workflowId  String
  name        String
  description String?
  category    String
  color       String   @default("#6B7280")
  position    Int      @default(0)
  isInitial   Boolean  @default(false)
  isTerminal  Boolean  @default(false)
  @@unique([workflowId, name])
  @@index([workflowId])
  @@map("workflow_states")
}

model WorkflowTransition {
  id             String   @id @default(uuid())
  workflowId     String
  name           String
  fromStateId    String?
  toStateId      String
  conditionType  String?
  conditionConfig Json    @default("{}")
  postActions    Json     @default("[]")
  isGlobal       Boolean  @default(false)
  position       Int      @default(0)
  @@unique([workflowId, fromStateId, toStateId])
  @@index([workflowId])
  @@map("workflow_transitions")
}

model WorkflowTransitionHistory {
  id            String   @id @default(uuid())
  workItemId    String
  transitionId  String?
  fromStateId   String?
  toStateId     String?
  performedById String?
  comment       String?
  performedAt   DateTime @default(now())
  @@index([workItemId])
  @@map("workflow_transition_history")
}

model Review {
  id            String   @id @default(uuid())
  spaceId       String
  title         String
  description   String?
  reviewType    String
  targetType    String
  targetId      String
  status        String   @default("pending")
  moderatorId   String?
  aspiceProcess String?
  dueDate       DateTime?
  createdById   String?
  createdAt     DateTime @default(now())
  completedAt   DateTime?
  @@map("reviews")
}

model ReviewParticipant {
  reviewId   String
  userId     String
  role       String   @default("reviewer")
  status     String   @default("pending")
  decisionAt DateTime?
  comment    String?
  @@id([reviewId, userId])
  @@map("review_participants")
}

model ReviewFinding {
  id          String   @id @default(uuid())
  reviewId    String
  title       String
  description String?
  severity    String   @default("minor")
  status      String   @default("open")
  location    Json?
  defectId    String?
  createdById String?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  @@map("review_findings")
}

model Approval {
  id              String   @id @default(uuid())
  entityType      String
  entityId        String
  approverId      String
  decision        String
  comment         String?
  signature       String?
  signatureMethod String?
  decidedAt       DateTime @default(now())
  @@unique([entityType, entityId, approverId])
  @@index([entityType, entityId])
  @@map("approvals")
}

model ElectronicSignature {
  id              String   @id @default(uuid())
  entityType      String
  entityId        String
  signerId        String
  signatureType   String
  signatureData   String
  contentHash     String?
  signedVersionId String?
  signedAt        DateTime @default(now())
  ipAddress       String?
  isEvidence      Boolean  @default(true)
  evidenceTag     String?
  comment         String?
  verificationStatus String @default("valid")
  revokedAt       DateTime?
  revokedById     String?
  @@unique([entityType, entityId, signerId])
  @@map("electronic_signatures")
}

// ═══════════════════════════════════════════
// Audit
// ═══════════════════════════════════════════

model AuditLog {
  id             String   @id @default(uuid())
  entityType     String
  entityId       String
  action         String
  fieldName      String?
  oldValue       Json?
  newValue       Json?
  diff           Json?
  actorId        String?
  actorIp        String?
  actorUserAgent String?
  sessionId      String?
  previousHash   String?
  chainHash      String
  isEvidence     Boolean  @default(false)
  evidenceTag    String?
  createdAt      DateTime @default(now())
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@index([isEvidence])
  @@map("audit_logs")
}

model EvidenceLink {
  id            String   @id @default(uuid())
  auditLogId    String
  aspiceProcess String
  aspiceClause  String?
  workItemId    String?
  description   String?
  createdAt     DateTime @default(now())
  @@index([aspiceProcess])
  @@map("evidence_links")
}

model ActivityFeed {
  id          String   @id @default(uuid())
  spaceId     String
  actorId     String?
  action      String
  targetType  String
  targetId    String
  targetTitle String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  @@index([spaceId, createdAt(sort: Desc)])
  @@map("activity_feed")
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  type       String
  title      String
  body       String?
  targetType String?
  targetId   String?
  isRead     Boolean  @default(false)
  readAt     DateTime?
  createdAt  DateTime @default(now())
  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationPreference {
  userId           String
  notificationType String
  channel          String @default("in_app")
  enabled          Boolean @default(true)
  @@id([userId, notificationType, channel])
  @@map("notification_preferences")
}

// ═══════════════════════════════════════════
// Process (ASPICE)
// ═══════════════════════════════════════════

model ProcessArea {
  id                   String   @id @default(uuid())
  code                 String   @unique
  name                 String
  category             String
  description          String?
  level                Int
  parentCode           String?
  requiredWorkProducts String[]
  sortOrder            Int      @default(0)
  @@map("process_areas")
}

model SpaceProcessArea {
  spaceId      String
  processCode  String
  isApplicable Boolean      @default(true)
  notes        String?
  @@id([spaceId, processCode])
  @@map("space_process_areas")
}

model AspiceDeliverable {
  id          String   @id @default(uuid())
  processCode String
  name        String
  shortName   String?
  description String?
  isMandatory Boolean  @default(true)
  templateId  String?
  sortOrder   Int      @default(0)
  @@map("aspice_deliverables")
}

model ProjectDeliverable {
  id             String   @id @default(uuid())
  spaceId        String
  deliverableId  String
  workItemId     String?
  status         String   @default("not_started")
  assignedToId   String?
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  @@unique([spaceId, deliverableId])
  @@map("project_deliverables")
}

model DeliverableVersion {
  id                    String   @id @default(uuid())
  projectDeliverableId  String
  workItemVersionId     String?
  baselineId            String?
  versionLabel          String?
  isReleased            Boolean  @default(false)
  createdAt             DateTime @default(now())
  @@map("deliverable_versions")
}

model ProcessAssessment {
  id             String   @id @default(uuid())
  spaceId        String
  processCode    String
  capabilityLevel Int
  assessmentDate DateTime
  assessorId     String?
  evidenceItems  String[]
  notes          String?
  createdAt      DateTime @default(now())
  @@map("process_assessments")
}

model ComplianceChecklist {
  id          String   @id @default(uuid())
  spaceId     String
  processCode String
  itemName    String
  description String?
  isRequired  Boolean  @default(true)
  status      String   @default("not_started")
  evidenceId  String?
  assignedToId String?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  @@index([spaceId])
  @@index([processCode])
  @@map("compliance_checklists")
}

// ═══════════════════════════════════════════
// Agile
// ═══════════════════════════════════════════

model Board {
  id           String   @id @default(uuid())
  spaceId      String
  name         String
  boardType    String
  filterJql    String?
  columnConfig Json     @default("{}")
  settings     Json     @default("{}")
  createdById  String?
  createdAt    DateTime @default(now())
  @@map("boards")
}

model Sprint {
  id          String   @id @default(uuid())
  boardId     String
  name        String
  goal        String?
  state       String   @default("future")
  startDate   DateTime?
  endDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  @@map("sprints")
}

model SprintItem {
  sprintId    String
  workItemId  String
  addedAt     DateTime @default(now())
  addedById   String?
  @@id([sprintId, workItemId])
  @@map("sprint_items")
}

model BacklogRanking {
  workItemId String   @id
  spaceId    String
  rank       String
  updatedAt  DateTime @updatedAt
  @@index([spaceId, rank])
  @@map("backlog_ranking")
}

// ═══════════════════════════════════════════
// Stakeholders
// ═══════════════════════════════════════════

model StakeholderType {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isInternal  Boolean  @default(false)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  @@map("stakeholder_types")
}

model ExternalOrganization {
  id            String   @id @default(uuid())
  orgId         String
  name          String
  orgType       String
  domain        String?
  contactEmail  String?
  contactPhone  String?
  address       String?
  hasNda        Boolean  @default(false)
  ndaSignedAt   DateTime?
  ndaDocumentId String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@map("external_organizations")
}

model UserStakeholderProfile {
  userId            String   @id
  stakeholderTypeId String
  externalOrgId     String?
  contractStart     DateTime?
  contractEnd       DateTime?
  isTemporary       Boolean  @default(false)
  allowedSpaces     String[]
  restrictedSpaces  String[]
  createdAt         DateTime @default(now())
  @@map("user_stakeholder_profiles")
}

model StakeholderAccessPolicy {
  id                       String   @id @default(uuid())
  stakeholderTypeId        String
  orgId                    String?
  scope                    String
  allowedActions           String[]
  deniedActions            String[]
  dataFilter               Json     @default("{}")
  documentAccess           String   @default("released_only")
  requireNda               Boolean  @default(false)
  requireApprovalForAccess Boolean  @default(false)
  createdAt                DateTime @default(now())
  @@unique([stakeholderTypeId, orgId])
  @@map("stakeholder_access_policies")
}

model SpaceStakeholderAccess {
  id                   String   @id @default(uuid())
  spaceId              String
  stakeholderTypeId    String
  externalOrgId        String?
  allowedWorkItemTypes String[]
  allowedStatuses      String[]
  allowedLabels        String[]
  deniedLabels         String[]
  dataFilter           Json     @default("{}")
  accessStart          DateTime @default(now())
  accessEnd            DateTime?
  grantedById          String?
  grantedAt            DateTime @default(now())
  isActive             Boolean  @default(true)
  @@unique([spaceId, stakeholderTypeId, externalOrgId])
  @@map("space_stakeholder_access")
}

model Invitation {
  id                String   @id @default(uuid())
  orgId             String
  email             String
  stakeholderTypeId String?
  externalOrgId     String?
  allowedSpaces     String[]
  dataFilter        Json     @default("{}")
  contractEnd       DateTime?
  token             String   @unique
  expiresAt         DateTime
  status            String   @default("pending")
  invitedById       String?
  acceptedById      String?
  acceptedAt        DateTime?
  createdAt         DateTime @default(now())
  @@index([token])
  @@index([email])
  @@index([status])
  @@map("invitations")
}

model RegistrationRequest {
  id                    String   @id @default(uuid())
  orgId                 String
  email                 String
  displayName           String
  requestedRole         String?
  reason                String?
  verificationToken     String?  @unique
  verificationExpiresAt DateTime?
  isEmailVerified       Boolean  @default(false)
  status                String   @default("pending")
  reviewedById          String?
  reviewedAt            DateTime?
  reviewComment         String?
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@map("registration_requests")
}

model ApprovalAuditLog {
  id            String   @id @default(uuid())
  action        String
  targetUserId  String
  performedById String
  oldStatus     String?
  newStatus     String?
  roleId        String?
  comment       String?
  ipAddress     String?
  createdAt     DateTime @default(now())
  @@map("approval_audit_log")
}

// ═══════════════════════════════════════════
// API Keys, MCP, Webhooks
// ═══════════════════════════════════════════

model ApiKey {
  id         String   @id @default(uuid())
  userId     String
  orgId      String
  name       String
  keyHash    String   @unique
  keyPrefix  String
  scopes     String[]
  expiresAt  DateTime?
  lastUsedAt DateTime?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

model McpSession {
  id               String   @id @default(uuid())
  userId           String
  sessionToken     String   @unique
  clientName       String?
  clientVersion    String?
  ipAddress        String?
  connectedAt      DateTime @default(now())
  lastActivityAt   DateTime @default(now())
  disconnectedAt   DateTime?
  @@map("mcp_sessions")
}

model Webhook {
  id          String   @id @default(uuid())
  orgId       String
  spaceId     String?
  name        String
  url         String
  secret      String?
  events      String[]
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  @@map("webhooks")
}

model WebhookDelivery {
  id             String   @id @default(uuid())
  webhookId      String
  eventType      String
  payload        Json
  responseStatus Int?
  responseBody   String?
  deliveredAt    DateTime?
  retryCount     Int      @default(0)
  nextRetryAt    DateTime?
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  @@map("webhook_deliveries")
}

// ═══════════════════════════════════════════
// NDA
// ═══════════════════════════════════════════

model NdaDocument {
  id            String   @id @default(uuid())
  orgId         String
  title         String
  version       String
  content       String
  effectiveDate DateTime?
  expiryDate    DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  @@map("nda_documents")
}

model NdaSignature {
  id             String   @id @default(uuid())
  ndaDocumentId  String
  userId         String
  externalOrgId  String?
  signature      String
  signatureMethod String
  ipAddress      String?
  signedAt       DateTime @default(now())
  auditLogId     String?
  @@unique([ndaDocumentId, userId])
  @@map("nda_signatures")
}

// ═══════════════════════════════════════════
// URL, Metrics, Project Templates
// ═══════════════════════════════════════════

model UrlSlug {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  slug       String
  isPrimary  Boolean  @default(true)
  redirectTo String?
  createdAt  DateTime @default(now())
  @@unique([entityType, slug])
  @@index([entityType, entityId])
  @@map("url_slugs")
}

model UrlAccessLog {
  id          String   @id @default(uuid())
  userId      String?
  url         String
  spaceKey    String?
  entityType  String?
  entityId    String?
  ipAddress   String?
  userAgent   String?
  accessedAt  DateTime @default(now())
  @@index([spaceKey, accessedAt(sort: Desc)])
  @@map("url_access_log")
}

model SpaceDailyMetric {
  spaceId              String
  metricDate           DateTime @db.Date
  totalItems           Int     @default(0)
  openItems            Int     @default(0)
  inProgressItems      Int     @default(0)
  doneItems            Int     @default(0)
  openDefects          Int     @default(0)
  criticalDefects      Int     @default(0)
  traceCoveragePercent Decimal @default(0) @db.Decimal(5,2)
  suspectLinksCount    Int     @default(0)
  testPassRate         Decimal @default(0) @db.Decimal(5,2)
  testExecutionCount   Int     @default(0)
  @@id([spaceId, metricDate])
  @@map("space_daily_metrics")
}

model ProjectTemplate {
  id                    String   @id @default(uuid())
  name                  String
  description           String?
  aspiceLevel           String
  automotiveDomain      String?
  processCodes          String[]
  workflowTemplateIds   String[]
  pageTemplateIds       String[]
  defaultRoles          Json     @default("[]")
  isSystem              Boolean  @default(false)
  createdAt             DateTime @default(now())
  @@map("project_templates")
}

model SpaceTemplateApplied {
  spaceId     String
  templateId  String
  appliedAt   DateTime        @default(now())
  appliedById String?
  @@id([spaceId, templateId])
  @@map("space_template_applied")
}

model SharedComponent {
  id            String   @id @default(uuid())
  orgId         String
  name          String
  description   String?
  componentType String?
  version       String?
  ownerSpaceId  String?
  createdAt     DateTime @default(now())
  @@map("shared_components")
}

model ComponentUsage {
  componentId String
  spaceId     String
  usedVersion String?
  addedAt     DateTime       @default(now())
  @@id([componentId, spaceId])
  @@map("component_usage")
}

model RoleResponsibility {
  id             String   @id @default(uuid())
  roleId         String
  spaceId        String
  aspiceProcess  String?
  responsibility String
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  @@unique([roleId, spaceId, aspiceProcess])
  @@map("role_responsibilities")
}

model CrossProjectLink {
  id          String   @id @default(uuid())
  fromSpaceId String
  fromType    String
  fromId      String
  toSpaceId   String
  toType      String
  toId        String
  linkType    String
  createdById String?
  createdAt   DateTime @default(now())
  @@map("cross_project_links")
}

model RequirementChangeHistory {
  id             String   @id @default(uuid())
  requirementId  String
  versionFrom    Int
  versionTo      Int
  changedFields  Json?
  changedById    String?
  changedAt      DateTime @default(now())
  @@map("requirement_change_history")
}

// ════════════════════════════════════════════════════════════════════════
// Template (조직 템플릿 + 버전 스냅샷)
// ════════════════════════════════════════════════════════════════════════

model TemplatePackage {
  id            String   @id @default(uuid())
  orgId         String
  name          String
  description   String?
  isSystem      Boolean  @default(false)
  isPublished   Boolean  @default(false)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@map("template_packages")
}

model TemplateVersion {
  id               String   @id @default(uuid())
  packageId        String
  version          Int
  name             String?
  description      String?
  processes        Json     @default("[]")
  workflows        Json     @default("[]")
  fieldDefinitions Json     @default("[]")
  deliverables     Json     @default("[]")
  rrDefaults       Json     @default("[]")
  wbsSkeleton      Json     @default("[]")
  createdById      String?
  createdAt        DateTime @default(now())
  @@unique([packageId, version])
  @@map("template_versions")
}

// ════════════════════════════════════════════════════════════════════════
// Process Workspace & Access (프로세스 워크스페이스, 할당, 접근)
// ════════════════════════════════════════════════════════════════════════

model ProcessWorkspace {
  id             String   @id @default(uuid())
  spaceId        String
  processCode    String
  name           String
  description    String?
  isApplicable   Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([spaceId, processCode])
  @@index([spaceId])
  @@map("process_workspaces")
}

model ProcessAssignment {
  id           String   @id @default(uuid())
  workspaceId  String
  roleId       String
  userId       String
  isPrimary    Boolean  @default(false)
  assignedById String?
  assignedAt   DateTime @default(now())
  expiresAt    DateTime?
  @@index([workspaceId])
  @@index([userId])
  @@map("process_assignments")
}

model ProcessAccessGrant {
  id           String   @id @default(uuid())
  workspaceId  String
  userId       String
  permission   String   @default("view")
  grantedById  String?
  grantedAt    DateTime @default(now())
  expiresAt    DateTime?
  @@index([workspaceId])
  @@index([userId])
  @@map("process_access_grants")
}

model FieldDefinition {
  id                   String   @id @default(uuid())
  spaceId              String?
  typeId               String?
  key                  String
  label                String
  labelKo              String?
  labelEn              String?
  fieldType            String
  isRequired           Boolean  @default(false)
  requiredForApproval  Boolean  @default(false)
  validation           Json     @default("{}")
  sortOrder            Int      @default(0)
  isSoftDeleted        Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  @@index([spaceId])
  @@index([typeId])
  @@map("field_definitions")
}

model AuditEvent {
  id           String   @id @default(uuid())
  entityType   String
  entityId     String
  action       String
  actorId      String?
  oldHash      String?
  newHash      String?
  chainHash    String
  createdAt    DateTime @default(now())
  ipAddress    String?
  userAgent    String?
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_events")
}
