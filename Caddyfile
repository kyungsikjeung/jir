# Caddyfile - 리버스 프록시 설정

:80 {
    # Frontend (React)
    handle / {
        reverse_proxy frontend:5173
    }

    # Backend API
    handle /api/* {
        reverse_proxy backend:3000
    }

    # MCP Server (SSE)
    handle /mcp/* {
        reverse_proxy backend:3000
    }

    # Keycloak
    handle /auth/* {
        reverse_proxy keycloak:8080
    }

    # MinIO Console
    handle /minio/* {
        reverse_proxy minio:9001
    }

    # MinIO API
    handle /storage/* {
        reverse_proxy minio:9000
    }

    # Health Check
    handle /health {
        reverse_proxy backend:3000
    }
}
